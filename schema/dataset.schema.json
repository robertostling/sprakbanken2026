{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprakbanken2026.org/schemas/temporal-qa.schema.json",
  "title": "Temporal Multilingual QA Dataset Schema",
  "description": "Schema for multilingual temporal question-answering dataset. Each entry contains questions in multiple languages and corresponding answers partitioned by language, where all answers in an entry consistently use either point-in-time dates or date ranges.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "oneOf": [
        {
          "title": "DateEntry",
          "description": "An entry where all answers specify a point-in-time date.",
          "type": "object",
          "required": [
            "questions",
            "answers"
          ],
          "additionalProperties": false,
          "properties": {
            "questions": {
              "$ref": "#/$defs/questionsList"
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dateLanguageAnswerGroup"
              }
            }
          }
        },
        {
          "title": "DateRangeEntry",
          "description": "An entry where all answers specify a date range.",
          "type": "object",
          "required": [
            "questions",
            "answers"
          ],
          "additionalProperties": false,
          "properties": {
            "questions": {
              "$ref": "#/$defs/questionsList"
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dateRangeLanguageAnswerGroup"
              }
            }
          }
        }
      ]
    },
    "questionsList": {
      "type": "array",
      "description": "List of question formulations across languages.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question",
          "language"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "The question text."
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "description": "The language code (e.g., 'ENG', 'SWE')."
          }
        }
      }
    },
    "dateLanguageAnswerGroup": {
      "type": "object",
      "description": "Answers for a specific language where each answer uses a point-in-time date.",
      "required": [
        "language",
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2,
          "description": "The language code corresponding to this answer group."
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dateAnswerItem"
          }
        }
      }
    },
    "dateRangeLanguageAnswerGroup": {
      "type": "object",
      "description": "Answers for a specific language where each answer uses a date range.",
      "required": [
        "language",
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2,
          "description": "The language code corresponding to this answer group."
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dateRangeAnswerItem"
          }
        }
      }
    },
    "dateAnswerItem": {
      "type": "object",
      "description": "A single point-in-time answer item.",
      "required": [
        "date",
        "answer",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Point-in-time date in YYYY-MM-DD format."
        },
        "answer": {
          "type": "string",
          "description": "The answer string."
        },
        "source": {
          "type": "string",
          "description": "Source citation or reference URL."
        }
      }
    },
    "dateRangeAnswerItem": {
      "type": "object",
      "description": "A single date range answer item.",
      "required": [
        "date_range",
        "answer",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "date_range": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "description": "Date interval with 'from' and 'to' boundaries.",
          "properties": {
            "from": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date in YYYY-MM-DD format."
            },
            "to": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date in YYYY-MM-DD format."
            }
          }
        },
        "answer": {
          "type": "string",
          "description": "The answer string."
        },
        "source": {
          "type": "string",
          "description": "Source citation or reference URL."
        }
      }
    }
  }
}
